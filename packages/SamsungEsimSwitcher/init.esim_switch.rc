# Bridge system-writable persist.sys prop into vendor.calls.* for rild shim.
on property:ro.boot.em.model=SM-A546B && property:persist.sys.esim_switch=1
    setprop vendor.calls.esim_switch 1

on property:ro.boot.em.model=SM-A546B && property:persist.sys.esim_switch=0
    setprop vendor.calls.esim_switch 0
