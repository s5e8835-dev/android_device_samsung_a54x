<!-- These resources are around just to allow their values to be customized -->
<resources>
    <!-- Threshold in micro watts below which a charger is rated as "slow"; 1A @ 5V -->
    <integer name="config_chargingSlowlyThreshold">5000</integer>

    <!-- Threshold in micro watts above which a charger is rated as "fast"; 1.5A @ 5V  -->
    <integer name="config_chargingFastThreshold">7500</integer>

    <!-- Charging info current divider, if needed -->
    <integer name="config_currentInfoDivider" translatable="false">1</integer>

    <!-- Keep the dim layer enabled as the Exynos HWC fingerprint mask marker. -->
    <bool name="config_udfpsFrameworkDimming">true</bool>

    <!-- Reject screen-off UDFPS presses while the proximity sensor reports near. -->
    <bool name="doze_long_press_proximity_check">true</bool>

    <!-- Compensate for the panel switching to mask level 322 (631 nits).
         Use the stock A546B nits curve with gamma 2.2 and keep at least one
         alpha step so the mask marker reaches HWC through the full 0-510 range. -->
    <string-array name="config_udfpsDimmingBrightnessAlphaArray" translatable="false">
        <item>0,236</item>
        <item>2,233</item>
        <item>4,229</item>
        <item>6,224</item>
        <item>8,220</item>
        <item>10,218</item>
        <item>13,213</item>
        <item>16,207</item>
        <item>20,202</item>
        <item>26,193</item>
        <item>32,186</item>
        <item>40,177</item>
        <item>50,166</item>
        <item>64,152</item>
        <item>80,139</item>
        <item>100,123</item>
        <item>128,102</item>
        <item>160,80</item>
        <item>192,61</item>
        <item>224,42</item>
        <item>255,26</item>
        <item>280,16</item>
        <item>300,8</item>
        <item>322,1</item>
        <item>510,1</item>
    </string-array>

    <!-- The CPU temperature divider, the thermal zone reports millidegrees -->
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>
</resources>
