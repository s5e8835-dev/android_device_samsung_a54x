<resources>

    <!-- Blur radius behind Notification Shade -->


    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
        relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">63.07</item>

    <!-- The padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">8dp</dimen>

    <!-- Status bar values -->
    <dimen name="status_bar_height_default">30dp</dimen>
    <dimen name="status_bar_height_portrait">30dp</dimen>
    <dimen name="status_bar_height_landscape">30dp</dimen>

    <!-- Bottom margin size when fingerprint in display is active -->
    <dimen name="keyguard_indication_margin_bottom">12dp</dimen>
</resources>
